# Supabase (opzionale — senza queste variabili l'app funziona in modalità locale/browser)
# VITE_SUPABASE_URL=https://xxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJ...

# Attivando VITE_SUPABASE_URL si abilita anche il fallback CORS automatico per Aruba:
# l'app deriva l'URL dell'Edge Function `aruba-proxy` da questa variabile.
# Per il deploy su Vercel, aggiungi le stesse variabili nel pannello Project → Settings → Environment Variables.
